# Copy this file to .env and fill in real values. Never commit .env.

# Postgres connection string
DATABASE_URL=postgresql://purslip:purslip@localhost:5433/purslip
# Set to true only if your Postgres provider requires SSL (e.g. most managed
# cloud Postgres, including Render's). Local docker-compose Postgres does not.
PGSSL=false

# Random long string used to sign session cookies. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=change-me-to-a-long-random-string

# development | production
NODE_ENV=development
PORT=3000

# --- Password reset email (configured in Phase 1) ---
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM="Purslip <no-reply@example.com>"

