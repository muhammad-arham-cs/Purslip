{
  "name": "purslip",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "description": "Personal finance management web app",
  "main": "dist/server.js",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/prepare-dist.mjs",
    "start": "node dist/server.js",
    "dev": "tsx watch --env-file=.env.local server.ts",
    "test": "jest --runInBand",
    "db:migrate": "node scripts/migrate.js",
    "db:migrate:profile": "node scripts/migrate-profile.js",
    "db:seed": "node scripts/seed.js"
  },
  "dependencies": {
    "@prisma/composer": "^0.36.0",
    "@prisma/composer-prisma-cloud": "^0.36.0",
    "bcryptjs": "^3.0.3",
    "chart.js": "^4.5.1",
    "compression": "^1.8.2",
    "connect-flash": "^0.1.1",
    "connect-pg-simple": "^10.0.0",
    "csv-parse": "^7.0.1",
    "dotenv": "^16.4.5",
    "ejs": "^6.0.1",
    "express": "^4.21.1",
    "express-rate-limit": "^7.4.1",
    "express-session": "^1.18.1",
    "express-validator": "^7.2.0",
    "helmet": "^8.0.0",
    "method-override": "^3.0.0",
    "morgan": "^1.10.0",
    "multer": "^2.2.0",
    "node-cron": "^4.6.0",
    "nodemailer": "^9.0.3",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@types/compression": "^1.8.1",
    "@types/connect-flash": "^0.0.40",
    "@types/connect-pg-simple": "^7.0.3",
    "@types/express": "^4.17.21",
    "@types/express-session": "^1.19.0",
    "@types/method-override": "^3.0.0",
    "@types/morgan": "^1.9.10",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.1",
    "jest": "^30.4.2",
    "nodemon": "^3.1.7",
    "prisma": "^8.0.0-rc.30",
    "supertest": "^7.0.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.2"
  }
}
