<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('../partials/head') %>
</head>
<body>
  <%- include('../partials/header') %>
  <main class="page">
    <section class="card" style="max-width: 480px;">
      <h1>Edit account</h1>
      <%- include('../partials/form-errors') %>
      <form method="POST" action="/accounts/<%= account.id %>?_method=PUT" novalidate>
        <div class="form-field">
          <label for="accountTitle">Account title</label>
          <input type="text" id="accountTitle" name="accountTitle" value="<%= values.account_title || values.name %>" required autofocus>
        </div>
        <div class="form-field">
          <label for="bankName">Bank / provider name</label>
          <input type="text" id="bankName" name="bankName" value="<%= values.bank_name || values.bankName || '' %>" required>
        </div>
        <div class="form-field">
          <label for="type">Type</label>
          <select id="type" name="type" required>
            <option value="checking" <%= values.type === 'checking' ? 'selected' : '' %>>Checking</option>
            <option value="savings" <%= values.type === 'savings' ? 'selected' : '' %>>Savings</option>
            <option value="credit_card" <%= values.type === 'credit_card' ? 'selected' : '' %>>Credit card</option>
            <option value="cash" <%= values.type === 'cash' ? 'selected' : '' %>>Cash</option>
            <option value="investment" <%= values.type === 'investment' ? 'selected' : '' %>>Investment</option>
            <option value="other" <%= values.type === 'other' ? 'selected' : '' %>>Other</option>
          </select>
        </div>
        <div class="form-field">
          <label for="currency">Currency code</label>
          <input type="text" id="currency" name="currency" maxlength="3" value="<%= values.currency %>" required>
        </div>
        <div class="form-field">
          <label for="openingBalance">Opening balance</label>
          <input type="number" step="0.01" id="openingBalance" name="openingBalance" value="<%= values.opening_balance || values.openingBalance %>" required>
          <small style="color: var(--color-text-muted);">Current balance: <%= account.current_balance %>. Changing the opening balance shifts the current balance by the same amount.</small>
        </div>
        <button class="button button--primary" type="submit">Save changes</button>
      </form>
    </section>
  </main>
  <%- include('../partials/footer') %>
</body>
</html>
