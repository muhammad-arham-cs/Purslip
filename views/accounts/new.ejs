<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('../partials/head') %>
</head>
<body>
  <%- include('../partials/header') %>
  <main class="page">
    <section class="card" style="max-width: 480px;">
      <h1>Add account</h1>
      <%- include('../partials/form-errors') %>
      <form method="POST" action="/accounts" novalidate>
        <div class="form-field">
          <label for="accountTitle">Account title</label>
          <input type="text" id="accountTitle" name="accountTitle" value="<%= values.accountTitle || values.name || '' %>" required autofocus>
        </div>
        <div class="form-field">
          <label for="bankName">Bank / provider name</label>
          <input type="text" id="bankName" name="bankName" value="<%= values.bankName || '' %>" required>
        </div>
        <div class="form-field">
          <label for="type">Type</label>
          <select id="type" name="type" required>
            <option value="checking" <%= values.type === 'checking' ? 'selected' : '' %>>Checking</option>
            <option value="savings" <%= values.type === 'savings' ? 'selected' : '' %>>Savings</option>
            <option value="credit_card" <%= values.type === 'credit_card' ? 'selected' : '' %>>Credit card</option>
            <option value="cash" <%= values.type === 'cash' ? 'selected' : '' %>>Cash</option>
            <option value="investment" <%= values.type === 'investment' ? 'selected' : '' %>>Investment</option>
            <option value="other" <%= values.type === 'other' ? 'selected' : '' %>>Other</option>
          </select>
        </div>
        <div class="form-field">
          <label for="currency">Currency code</label>
          <input type="text" id="currency" name="currency" maxlength="3" value="<%= values.currency || 'PKR' %>" required>
        </div>
        <div class="form-field">
          <label for="openingBalance">Opening balance</label>
          <input type="number" step="0.01" id="openingBalance" name="openingBalance" value="<%= values.openingBalance || '0' %>" required>
        </div>
        <button class="button button--primary" type="submit">Create account</button>
      </form>
    </section>
  </main>
  <%- include('../partials/footer') %>
</body>
</html>
