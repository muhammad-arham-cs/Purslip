<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('../partials/head') %>
</head>
<body>
  <%- include('../partials/header') %>
  <main id="mainContent" class="page page--auth">
    <section class="auth-panel">
      <div class="auth-panel__intro">
        <a class="auth-panel__brand" href="/" aria-label="Purslip home">
          <%- include('../partials/logo-mark') %>
          <span>Purslip</span>
        </a>
        <h1>Recover your account access.</h1>
        <p>Verify your email address and CNIC to set a new password for your Purslip ledger.</p>
      </div>
      <div class="card auth-card">
        <h2>Forgot password</h2>
        <%- include('../partials/form-errors') %>
        <form method="POST" action="/auth/forgot-password" novalidate>
          <div class="form-field">
            <label for="email">Email</label>
            <input type="email" id="email" name="email" value="<%= values.email || '' %>" autocomplete="email" required autofocus>
          </div>
          <div class="form-field">
            <label for="cnic">CNIC</label>
            <input type="text" id="cnic" name="cnic" required autocomplete="off">
          </div>
          <button class="button button--primary button--block" type="submit">Send reset link</button>
        </form>
        <div class="auth-card__links">
          <p><a href="/auth/login">Back to log in</a></p>
        </div>
      </div>
    </section>
  </main>
  <%- include('../partials/footer') %>
</body>
</html>
