<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('../partials/head') %>
</head>
<body>
  <%- include('../partials/header') %>
  <main class="page page--centered">
    <section class="card" style="max-width: 420px; width: 100%; text-align: left;">
      <h1>Forgot password</h1>
      <%- include('../partials/form-errors') %>
      <form method="POST" action="/auth/forgot-password" novalidate>
        <div class="form-field">
          <label for="email">Email</label>
          <input type="email" id="email" name="email" value="<%= values.email || '' %>" required autofocus>
        </div>
        <div class="form-field">
          <label for="cnic">CNIC</label>
          <input type="text" id="cnic" name="cnic" required autocomplete="off">
        </div>
        <button class="button button--primary" type="submit" style="width:100%;">Send reset link</button>
      </form>
      <p><a href="/auth/login">Back to log in</a></p>
    </section>
  </main>
  <%- include('../partials/footer') %>
</body>
</html>
