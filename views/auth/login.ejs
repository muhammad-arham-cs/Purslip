<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('../partials/head') %>
</head>
<body>
  <%- include('../partials/header') %>
  <main id="mainContent" class="page page--auth">
    <section class="auth-panel">
      <div class="auth-panel__intro">
        <a class="auth-panel__brand" href="/" aria-label="Purslip home">
          <%- include('../partials/logo-mark') %>
          <span>Purslip</span>
        </a>
        <h1>Your money, in focus.</h1>
        <p>Pick up where you left off with a clear daily view of your accounts, cards, budgets, goals and recurring bills.</p>
        <div class="auth-security-pills">
          <span class="security-pill">
            <svg class="icon" aria-hidden="true"><use href="#i-lock"/></svg>
            <span>5-attempt login shield</span>
          </span>
          <span class="security-pill">
            <svg class="icon" aria-hidden="true"><use href="#i-recurring"/></svg>
            <span>5-min idle auto-logout</span>
          </span>
        </div>
      </div>
      <div class="card auth-card glass-panel">
        <h2>Log in</h2>
        <%- include('../partials/form-errors') %>
        <% if (typeof cooldownSeconds === 'number' && cooldownSeconds > 0) { %>
          <div class="cooldown-banner" data-cooldown-seconds="<%= cooldownSeconds %>" role="timer" aria-live="polite">
            <svg class="icon" aria-hidden="true"><use href="#i-lock"/></svg>
            <div>
              <strong>Cooldown active</strong>
              <p>Login unlocks in <span class="num" data-cooldown-counter><%= cooldownSeconds %>s</span>.</p>
            </div>
          </div>
        <% } else if (typeof attemptsRemaining === 'number' && attemptsRemaining >= 0 && attemptsRemaining < 5) { %>
          <p class="auth-attempts-note" role="status">
            <strong><%= attemptsRemaining %></strong> attempt<%= attemptsRemaining === 1 ? '' : 's' %> remaining before a 5-minute security cooldown.
          </p>
        <% } %>
        <form method="POST" action="/auth/login" novalidate>
          <div class="form-field">
            <label for="email">Email</label>
            <input type="email" id="email" name="email" value="<%= values.email || '' %>" autocomplete="email" required autofocus>
          </div>
          <div class="form-field">
            <label for="password">Password</label>
            <input type="password" id="password" name="password" autocomplete="current-password" required>
          </div>
          <button class="button button--primary button--block" type="submit" id="loginSubmitBtn" <%= (typeof cooldownSeconds === 'number' && cooldownSeconds > 0) ? 'disabled' : '' %>>Log in</button>
        </form>
        <div class="auth-card__links">
          <p><a href="/auth/forgot-password">Forgot your password?</a></p>
          <p>New here? <a href="/auth/signup">Create an account</a></p>
        </div>
      </div>
    </section>
  </main>
  <%- include('../partials/footer') %>
</body>
</html>
