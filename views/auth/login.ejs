<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('../partials/head') %>
</head>
<body>
  <%- include('../partials/header') %>
  <main class="page page--centered">
    <section class="card" style="max-width: 420px; width: 100%; text-align: left;">
      <h1>Log in</h1>
      <%- include('../partials/form-errors') %>
      <form method="POST" action="/auth/login" novalidate>
        <div class="form-field">
          <label for="email">Email</label>
          <input type="email" id="email" name="email" value="<%= values.email || '' %>" required autofocus>
        </div>
        <div class="form-field">
          <label for="password">Password</label>
          <input type="password" id="password" name="password" required>
        </div>
        <button class="button button--primary" type="submit" style="width:100%;">Log in</button>
      </form>
      <p><a href="/auth/forgot-password">Forgot your password?</a></p>
      <p>New here? <a href="/auth/signup">Sign up</a></p>
    </section>
  </main>
  <%- include('../partials/footer') %>
</body>
</html>
