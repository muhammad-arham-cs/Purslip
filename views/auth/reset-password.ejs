<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('../partials/head') %>
</head>
<body>
  <%- include('../partials/header') %>
  <main class="page page--centered">
    <section class="card" style="max-width: 420px; width: 100%; text-align: left;">
      <h1>Reset password</h1>
      <%- include('../partials/form-errors') %>
      <form method="POST" action="/auth/reset-password/<%= token %>" novalidate>
        <div class="form-field">
          <label for="password">New password</label>
          <input type="password" id="password" name="password" minlength="8" required autofocus>
        </div>
        <div class="form-field">
          <label for="passwordConfirm">Confirm new password</label>
          <input type="password" id="passwordConfirm" name="passwordConfirm" minlength="8" required>
        </div>
        <button class="button button--primary" type="submit" style="width:100%;">Update password</button>
      </form>
    </section>
  </main>
  <%- include('../partials/footer') %>
</body>
</html>
