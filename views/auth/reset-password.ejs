<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('../partials/head') %>
</head>
<body>
  <%- include('../partials/header') %>
  <main id="mainContent" class="page page--auth">
    <section class="auth-panel">
      <div class="auth-panel__intro">
        <a class="auth-panel__brand" href="/" aria-label="Purslip home">
          <%- include('../partials/logo-mark') %>
          <span>Purslip</span>
        </a>
        <h1>Choose a new password.</h1>
        <p>Enter a strong password of at least 8 characters to secure your Purslip account.</p>
      </div>
      <div class="card auth-card">
        <h2>Reset password</h2>
        <%- include('../partials/form-errors') %>
        <form method="POST" action="/auth/reset-password/<%= token %>" novalidate>
          <div class="form-field">
            <label for="password">New password</label>
            <input type="password" id="password" name="password" minlength="8" autocomplete="new-password" required autofocus>
          </div>
          <div class="form-field">
            <label for="passwordConfirm">Confirm new password</label>
            <input type="password" id="passwordConfirm" name="passwordConfirm" minlength="8" autocomplete="new-password" required>
          </div>
          <button class="button button--primary button--block" type="submit">Update password</button>
        </form>
      </div>
    </section>
  </main>
  <%- include('../partials/footer') %>
</body>
</html>
