<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('../partials/head') %>
</head>
<body>
  <%- include('../partials/header') %>
  <main class="page">
    <div style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap: 8px; margin-bottom: 16px;">
      <h1 style="margin:0;">Budgets</h1>
      <div class="button-row" style="margin:0;">
        <a class="button" href="/budgets?month=<%= prevMonth %>">&larr; <%= prevMonth %></a>
        <span style="align-self:center; font-weight:600;"><%= month %></span>
        <a class="button" href="/budgets?month=<%= nextMonth %>"><%= nextMonth %> &rarr;</a>
      </div>
    </div>

    <% if (!rows.length) { %>
      <div class="card"><p>No expense categories yet. <a href="/categories/new">Add one</a> to start budgeting.</p></div>
    <% } else { %>
      <div class="grid grid--2">
        <% rows.forEach(function(r) { %>
          <div class="card">
            <div style="display:flex; justify-content:space-between; align-items:start;">
              <h2 style="margin: 0 0 4px;">
                <%= r.category.name %>
                <% if (r.category.rollover) { %><span style="font-size:0.75rem; color: var(--color-text-muted); font-weight:400;"> &middot; rollover on</span><% } %>
              </h2>
            </div>

            <p style="margin: 0 0 4px; color: var(--color-text-muted);">
              Spent <%= r.spent.toFixed(2) %> of <%= r.available.toFixed(2) %> available
              <% if (r.category.rollover && r.budgetAmount !== null && Number(r.budgetAmount) !== r.available) { %>
                (budget <%= Number(r.budgetAmount).toFixed(2) %> + rollover)
              <% } %>
            </p>
            <div class="progress-bar">
              <div class="progress-bar__fill <%= r.isOverBudget ? 'is-over' : '' %>" style="width: <%= Math.min(100, r.percentUsed) %>%;"></div>
            </div>
            <% if (r.isOverBudget) { %>
              <p style="color: var(--color-danger); font-weight:600; margin: 4px 0 12px;">Over budget by <%= Math.abs(r.remaining).toFixed(2) %></p>
            <% } else { %>
              <p style="margin: 4px 0 12px;"><%= r.remaining.toFixed(2) %> remaining</p>
            <% } %>

            <form action="/budgets/<%= r.category.id %>?_method=PUT&month=<%= month %>" method="POST" class="button-row" style="justify-content:flex-start;">
              <input type="number" step="0.01" min="0" name="amount" value="<%= r.budgetAmount !== null ? r.budgetAmount : '' %>" placeholder="Set budget" style="max-width: 140px; padding: 8px; border-radius: var(--radius); border: 1px solid var(--color-border); background: var(--color-surface); color: var(--color-text);">
              <button class="button button--primary" type="submit">Save</button>
            </form>
          </div>
        <% }) %>
      </div>
    <% } %>
  </main>
  <%- include('../partials/footer') %>
</body>
</html>
