<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('../partials/head') %>
</head>
<body>
  <%- include('../partials/header') %>
  <main id="mainContent" class="page page--centered">
    <section class="slip-card error-card" aria-labelledby="error500Heading">
      <div class="error-card__badge">
        <span class="status-pill status-pill--danger">HTTP 500 &middot; Temporary error</span>
      </div>
      <h1 id="error500Heading">Something went wrong</h1>
      <p class="error-card__lead">
        Your balances and data are safe, but this request could not be completed right now. Try the action again or return to your dashboard.
      </p>
      <div class="button-row error-card__actions">
        <a class="button button--primary" href="<%= retryPath || '/' %>">Try again</a>
        <a class="button button--ghost" href="/dashboard">Dashboard</a>
      </div>
    </section>
  </main>
  <%- include('../partials/footer') %>
</body>
</html>
