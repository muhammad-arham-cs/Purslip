<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('../partials/head') %>
</head>
<body>
  <%- include('../partials/header') %>
  <main class="page">
    <section class="card" style="max-width: 560px;">
      <h1>Add recurring transaction</h1>
      <%- include('../partials/form-errors') %>
      <form method="POST" action="/recurring" novalidate>
        <div class="form-field">
          <label for="accountId">Account</label>
          <select id="accountId" name="accountId" required>
            <% accounts.forEach(function(a) { %>
              <option value="<%= a.id %>" <%= String(values.accountId) === String(a.id) ? 'selected' : '' %>><%= a.account_title || a.name %> (<%= a.bank_name || '—' %>)</option>
            <% }) %>
          </select>
        </div>
        <div class="form-field">
          <label for="categoryId">Category</label>
          <select id="categoryId" name="categoryId">
            <option value="">Uncategorized</option>
            <% categories.forEach(function(c) { %>
              <option value="<%= c.id %>" <%= String(values.categoryId) === String(c.id) ? 'selected' : '' %>><%= c.name %></option>
            <% }) %>
          </select>
        </div>
        <div class="grid grid--2">
          <div class="form-field">
            <label for="type">Type</label>
            <select id="type" name="type" required>
              <option value="expense" <%= values.type === 'expense' ? 'selected' : '' %>>Expense (bill)</option>
              <option value="income" <%= values.type === 'income' ? 'selected' : '' %>>Income (e.g. salary)</option>
            </select>
          </div>
          <div class="form-field">
            <label for="amount">Amount</label>
            <input type="number" step="0.01" min="0.01" id="amount" name="amount" value="<%= values.amount || '' %>" required>
          </div>
        </div>
        <div class="grid grid--2">
          <div class="form-field">
            <label for="payee">Payee</label>
            <input type="text" id="payee" name="payee" value="<%= values.payee || '' %>">
          </div>
          <div class="form-field">
            <label for="note">Note</label>
            <input type="text" id="note" name="note" value="<%= values.note || '' %>">
          </div>
        </div>
        <div class="form-field">
          <label for="frequency">Frequency</label>
          <select id="frequency" name="frequency" required>
            <% frequencies.forEach(function(f) { %>
              <option value="<%= f %>" <%= values.frequency === f ? 'selected' : '' %>><%= f.replace('_', ' ') %></option>
            <% }) %>
          </select>
        </div>
        <div class="form-field" id="customIntervalField" style="display: <%= values.frequency === 'custom_days' ? 'block' : 'none' %>;">
          <label for="customIntervalDays">Every how many days?</label>
          <input type="number" min="1" id="customIntervalDays" name="customIntervalDays" value="<%= values.customIntervalDays || '' %>">
        </div>
        <div class="grid grid--2">
          <div class="form-field">
            <label for="startDate">Start date</label>
            <input type="date" id="startDate" name="startDate" value="<%= values.startDate || '' %>" required>
          </div>
          <div class="form-field">
            <label for="endDate">End date (optional)</label>
            <input type="date" id="endDate" name="endDate" value="<%= values.endDate || '' %>">
          </div>
        </div>
        <button class="button button--primary" type="submit">Create</button>
      </form>
    </section>
  </main>
  <%- include('../partials/footer') %>
  <script src="/js/recurring-form.js"></script>
</body>
</html>
