<%- include('../partials/head', { title }) %>
<%- include('../partials/header') %>
<main class="container">
  <h1><%= t('Settings') %></h1>
  <%- include('../partials/form-errors', { errors }) %>
  <form method="POST" action="/settings" class="form-card">
    <div class="form-field">
      <label for="displayCurrency"><%= t('Display currency') %></label>
      <select id="displayCurrency" name="displayCurrency" required>
        <% supportedCurrencies.forEach((currency) => { %>
          <option value="<%= currency %>" <%= preferences.display_currency === currency ? 'selected' : '' %>><%= currency %></option>
        <% }) %>
      </select>
    </div>
    <div class="form-field">
      <label for="language"><%= t('Language') %></label>
      <select id="language" name="language" required>
        <% supportedLanguages.forEach((language) => { %>
          <option value="<%= language %>" <%= preferences.language === language ? 'selected' : '' %>><%= language === 'ur' ? t('Urdu') : t('English') %></option>
        <% }) %>
      </select>
    </div>
    <div class="form-field">
      <label for="theme"><%= t('Theme') %></label>
      <select id="theme" name="theme" required>
        <% supportedThemes.forEach((themeOption) => { %>
          <option value="<%= themeOption %>" <%= preferences.theme === themeOption ? 'selected' : '' %>><%= t(`${themeOption === 'light' ? 'Light mode' : themeOption === 'night' ? 'Night mode' : 'Dark mode'}`) %></option>
        <% }) %>
      </select>
    </div>
    <p>Enter how many units of each currency equal 1 PKR. Account balances remain stored in their native currency.</p>
    <% supportedCurrencies.forEach((currency) => { %>
      <div class="form-field">
        <label for="rate<%= currency %>"><%= currency %> rate per PKR</label>
        <input id="rate<%= currency %>" name="rate<%= currency %>" type="number" step="0.000001" min="0.000001"
               value="<%= preferences.exchange_rates[currency] || (currency === 'PKR' ? 1 : '') %>" required>
      </div>
    <% }) %>
    <button class="button button--primary" type="submit"><%= t('Save settings') %></button>
  </form>
</main>
<%- include('../partials/footer') %>
