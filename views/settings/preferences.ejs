<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('../partials/head', { title }) %>
</head>
<body>
  <%- include('../partials/header') %>
  <main id="mainContent" class="page settings-page settings-editor-page">
    <a class="back-link" href="/settings">
      <svg class="icon" aria-hidden="true"><use href="#i-arrow-left"/></svg>
      <span>Back to settings</span>
    </a>
    <div class="settings-page__heading">
      <h1>Preferences</h1>
      <p class="settings-page__intro">Set your display currency, manual exchange rates, language, and theme.</p>
    </div>
    <%- include('../partials/form-errors', { errors }) %>
    <section class="card settings-editor-card">
      <form method="POST" action="/settings/preferences">
        <div class="settings-fields">
          <div class="form-field">
            <label for="displayCurrency"><%= t('Display currency') %></label>
            <select id="displayCurrency" name="displayCurrency" required>
              <% supportedCurrencies.forEach((currency) => { %>
                <option value="<%= currency %>" <%= preferences.display_currency === currency ? 'selected' : '' %>><%= currency %></option>
              <% }) %>
            </select>
          </div>
          <div class="form-field">
            <label for="language"><%= t('Language') %></label>
            <select id="language" name="language" required>
              <% supportedLanguages.forEach((language) => { %>
                <option value="<%= language %>" <%= preferences.language === language ? 'selected' : '' %>><%= language === 'ur' ? t('Urdu') : t('English') %></option>
              <% }) %>
            </select>
          </div>
          <div class="form-field">
            <label for="theme"><%= t('Theme') %></label>
            <select id="theme" name="theme" required>
              <% supportedThemes.forEach((themeOption) => { %>
                <option value="<%= themeOption %>" <%= preferences.theme === themeOption ? 'selected' : '' %>><%= t(`${themeOption === 'light' ? 'Light mode' : themeOption === 'night' ? 'Night mode' : 'Dark mode'}`) %></option>
              <% }) %>
            </select>
          </div>
          <% supportedCurrencies.forEach((currency) => { %>
            <div class="form-field">
              <label for="rate<%= currency %>"><%= currency %> rate per PKR</label>
              <input id="rate<%= currency %>" name="rate<%= currency %>" type="number" step="0.000001" min="0.000001" value="<%= preferences.exchange_rates[currency] || (currency === 'PKR' ? 1 : '') %>" required>
            </div>
          <% }) %>
        </div>
        <div class="button-row"><button class="button button--primary" type="submit">Save preferences</button><a class="button button--ghost" href="/settings">Cancel</a></div>
      </form>
    </section>
  </main>
  <%- include('../partials/footer') %>
</body>
</html>
