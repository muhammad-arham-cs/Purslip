<%- include('../partials/head', { title }) %>
<%- include('../partials/header') %>
<main class="page settings-page settings-editor-page">
  <a class="back-link" href="/settings">← Back to settings</a>
  <div class="settings-page__heading"><p class="eyebrow">SECURITY</p><h1>Change email</h1><p class="settings-page__intro">Update the email address used to sign in to Purslip.</p></div>
  <%- include('../partials/form-errors', { errors }) %>
  <section class="card settings-editor-card">
    <form method="POST" action="/settings/security/email">
      <div class="form-field"><label for="securityEmail">New email</label><input id="securityEmail" name="email" type="email" value="<%= profile.email %>" required></div>
      <div class="form-field"><label for="emailCurrentPassword">Current password</label><input id="emailCurrentPassword" name="currentPassword" type="password" autocomplete="current-password" required></div>
      <div class="button-row"><button class="button button--primary" type="submit">Save email</button><a class="button button--ghost" href="/settings">Cancel</a></div>
    </form>
  </section>
</main>
<%- include('../partials/footer') %>
